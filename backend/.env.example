# ── Required ──────────────────────────────────────────────────────────────────
# Fernet-compatible 32-byte URL-safe base64 key for encrypting API keys at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./codesense.db
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:3000

# Simple bearer token to protect API endpoints (leave empty to disable auth)
API_AUTH_TOKEN=
